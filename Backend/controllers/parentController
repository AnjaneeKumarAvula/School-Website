// --- Parent side APIs ---

// POST /parent/auth/login
export const loginParent = async (req, res) => {
  try {
    const { email, password } = req.body;
    
    if (!email || !password) {
      return res.status(400).json({ message: "Email and password are required" });
    }

    // Find parent by email
    const parent = await Parent.findOne({ email });
    
    if (!parent) {
      return res.status(401).json({ message: "Invalid email or password" });
    }

    // Check password (plain text for now - in production, use bcrypt)
    if (parent.password !== password) {
      return res.status(401).json({ message: "Invalid email or password" });
    }

    // Generate a simple token (in production, use JWT)
    const token = `parent_${parent._id}_${Date.now()}`;

    res.json({
      message: "Login successful",
      token,
      parent: {
        id: parent._id,
        email: parent.email,
        parentName: parent.parentName,
        studentRollNo: parent.studentRollNo,
      },
    });
  } catch (err) {
    console.error(err);
    res.status(500).json({ message: "Error during login" });
  }
};

// GET /parent/student/details
export const getStudentDetails = async (req, res) => {
  try {
    const parentEmail = req.query.email;
    
    if (!parentEmail) {
      // Fallback to demo data if no email provided
      const { student } = await getCurrentParentContext();
      return res.json({
        name: student.name,
        rollNo: student.rollNo,
        className: student.className,
        parentName: student.parentName,
        mentorName: student.mentorName,
        presentDays: student.presentDays,
        absentDays: student.absentDays,
      });
    }

    // Find parent by email
    const parent = await Parent.findOne({ email: parentEmail });
    if (!parent) {
      return res.status(404).json({ message: "Parent not found" });
    }

    // Find student by rollNo
    const student = await Student.findOne({ rollNo: parent.studentRollNo });
    if (!student) {
      return res.status(404).json({ message: "Student not found" });
    }

    res.json({
      name: student.name,
      rollNo: student.rollNo,
      className: student.className,
      parentName: student.parentName,
      mentorName: student.mentorName,
      presentDays: student.presentDays,
      absentDays: student.absentDays,
    });
  } catch (err) {
    console.error(err);
    res.status(500).json({ message: "Error fetching student details" });
  }
};

