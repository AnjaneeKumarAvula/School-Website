  } catch (err) {
    console.error(err);
    res.status(500).json({ message: "Error fetching students" });
  }
};
export const sendMessageToParent = async (req, res) => {
  try {
    const { rollNo, message } = req.body;
    if (!rollNo || !message || !message.trim()) {
      return res.status(400).json({ message: "Roll number and message required" });
    }
    
    const student = await Student.findOne({ rollNo });
    if (!student) {
      return res.status(400).json({ message: "Student not found" });
    }
    const parent = await Parent.findOne({ studentRollNo: rollNo });
    if (!parent) {
      return res.status(400).json({ message: "Parent not found for this student" });
    }

    const msg = await TeacherParentMessage.create({
      rollNo,
      parentName: parent.parentName,
      message,
    });

    res.json({ message: "Message sent to parent", data: msg });
  } catch (err) {
    console.error(err);
    res.status(500).json({ message: "Error sending message to parent" });
  }
};
